# Copy to .env and fill in:  cp .env.example .env   (.env is git-ignored; never commit it)
# Real environment variables override .env; CLI flags override both.

# --- Required for every run (local and remote) -------------------------------------------------------------
# Anthropic API key, from https://console.anthropic.com
ANTHROPIC_API_KEY=
# Local runs only: instead of ANTHROPIC_API_KEY you may use an auth token (or an `ant auth login` profile).
# Remote runs always need ANTHROPIC_API_KEY.
# ANTHROPIC_AUTH_TOKEN=

# --- Required for remote runs only (python main.py build-template / remote) --------------------------------
# E2B API key, from https://e2b.dev/dashboard (the free Hobby tier is enough)
E2B_API_KEY=

# --- Optional: defaults for both main.py local and remote (flags: --model, --max-turns, --max-tokens) -------
OVERVIEW_MODEL=claude-sonnet-5-5
OVERVIEW_MAX_TURNS=25
OVERVIEW_MAX_TOKENS=16000
# Which engine runs the agent: api (hand-written Messages API loop) or agent-sdk (Claude Agent SDK).
OVERVIEW_ENGINE=api

# --- Optional: local runs only (main.py local with no repo argument) -----------------------------------------
OVERVIEW_REPO_PATH=.
